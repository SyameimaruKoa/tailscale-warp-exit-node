# TailscaleのAuth Key（初回認証時のみ必須）
# 認証完了後は ./data_tailscale/ に状態が保存されるため、
# キーが期限切れでもコンテナの再起動に影響しません。
TS_AUTHKEY=tskey-auth-example-key

# Tailscale上での表示名（任意）
# 設定しない場合、自動的に "warp-[サーバーのホスト名]" が使用されます
# TS_HOSTNAME=warp-my-server

# macvlan親物理インターフェース（Linux標準は eth0、WSL環境などは eth1 等を設定）
MACVLAN_PARENT=eth0

# macvlan用物理ネットワークのサブネットとゲートウェイ
MACVLAN_SUBNET=192.168.55.0/24
MACVLAN_GATEWAY=192.168.55.1