# TailscaleのAuth Key（初回認証時のみ必須）
# 認証完了後は ./data_tailscale/ に状態が保存されるため、
# キーが期限切れでもコンテナの再起動に影響しません。
TS_AUTHKEY=tskey-auth-example-key

# Tailscale上での表示名（任意）
# 設定しない場合、自動的に "warp-[サーバーのホスト名]" が使用されます
# TS_HOSTNAME=warp-my-server

# 経路分離の上書き設定（任意・通常は不要）
# TS_FWMARK: tailscaledの bypass fwmark。未設定時はtailscaledのルールから自動検出され、
# 検出できない場合のみ既定値 0x80000/0xff0000 が使われます
# TS_FWMARK=0x80000/0xff0000
# UNDERLAY_TABLE: 経路分離用ルーティングテーブルの番号
# UNDERLAY_TABLE=100